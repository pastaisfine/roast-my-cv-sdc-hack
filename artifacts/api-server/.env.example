# Local environment for the API server. Copy to `.env` and fill in the real values.
#
#   cp artifacts/api-server/.env.example artifacts/api-server/.env
#
# The `.env` file is gitignored. The server reads it automatically through Node's
# built-in `--env-file-if-exists` flag, so there is no dotenv dependency.
#
# On Replit, set these as workspace Secrets instead. Do not commit real values here.

# --- Required by the server process ---
PORT=8080
NODE_ENV=development

# Postgres connection string. The embedding cache is optional: without it the
# server still works, it just recomputes the public catalogue vectors each time.
DATABASE_URL=postgres://user:password@localhost:5432/roastmycv

# --- RunPod embeddings (optional) ---
# Without these, the radar falls back to deterministic keyword matching.
# The endpoint id is NOT a secret; the API key is. Generate the key in the Runpod
# console under Credentials > API Keys: https://console.runpod.io/user/credentials
RUNPOD_ENDPOINT_ID=oqdvb7vyxw2eio
RUNPOD_API_KEY=
RADAR_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# Master switch. Leave false until the endpoint and key are both verified.
RADAR_RUNPOD_APPROVED=false
# Gates the paid evaluation that writes radar-smoke-result.json. Enable only for
# the run itself, then turn it off again.
RADAR_PAID_SMOKE_APPROVED=false

# --- OCR (optional) ---
# Unset or true keeps the Python image worker enabled (Replit / local). Hosts
# that cannot run the Python subprocess set this to false and the OCR endpoint
# answers 501 deterministically.
OCR_ENABLED=true
