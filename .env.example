# Roast/Gemini settings for the workspace root `.env`.
#
# The API server loads `artifacts/api-server/.env` first and this file second,
# so values here override the package file. Keep the existing database and
# RunPod settings in `artifacts/api-server/.env`; do not copy empty defaults
# here or they will override working credentials.
#
# Never commit `.env`: it is gitignored.

# Google AI Studio API key. AI Studio now issues AQ. keys; both AQ. and AIza
# keys are accepted. Keep this server-side only.
GEMINI_API_KEY=
# Free-tier Flash model. Override only with a model that supports structured
# output and is available on your project's tier.
GEMINI_MODEL=gemini-3.6-flash

# Roast endpoint switches and per-process cost guards.
# Free tier for gemini-3.6-flash is 5 requests/minute per project/model. One
# roast uses two calls (extraction + narrative), so 5 supports ~2 roasts/min;
# beyond that the endpoint returns the deterministic fallback. Raise these only
# with a paid quota.
ROAST_ENABLED=true
ROAST_RPM_LIMIT=5
ROAST_DAILY_TOKEN_LIMIT=800000

# Set to false on serverless hosts without the Python OCR worker.
OCR_ENABLED=true
